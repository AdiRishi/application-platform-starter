{
  "extends": "@repo/tsconfig/react.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [
      "vite/client",
      "vitest/globals",
      "vitest/jsdom",
      "@testing-library/jest-dom",
      "@cloudflare/workers-types"
