{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalDependencies": [".node-version", "pnpm-lock.yaml", "pnpm-workspace.yaml"],
  "globalPassThroughEnv": ["ALCHEMY_*", "CLOUDFLARE_*"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"]
    },
    "@repo/web#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@repo/infra#deploy": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "@repo/web#test": {
      "dependsOn": ["^test", "build"]
    }
  }
}
